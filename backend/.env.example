# Felineye Backend Configuration
# Export these variables in your shell or pass uvicorn flags; .env is not loaded automatically.
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
# CORS origins are currently hardcoded in app/config.py; this value is not read yet.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Identification Service Configuration
# CLASSIFIER_PROVIDER: auto | bioclip | imagenet | consensus | dev_mock
CLASSIFIER_PROVIDER=auto
# Optional model path overrides (defaults are relative to backend/)
# BIOCLIP_MODEL_PATH=models/bioclip_vit_b16_vision.onnx
# BIOCLIP_TEXT_EMBEDDINGS_PATH=app/data/bioclip_text_embeddings.npz
# IMAGENET_MODEL_PATH=models/mobilenetv2-12.onnx
# IMAGENET_LABELS_PATH=app/data/imagenet_classes.txt
# Optional domestic-cat breed estimator (visual estimate only, never XP)
BREED_CLASSIFIER_ENABLED=true
# BREED_MODEL_PATH=models/cat_breed_vit.onnx
# BREED_LABELS_PATH=app/data/cat_breed_labels.json
# BREED_MIN_CONFIDENCE=0.45
# BREED_MIN_MARGIN=0.10
MAX_IMAGE_SIZE_MB=15

# External Wildlife APIs (Optional keys for higher rate limits)
INATURALIST_API_BASE=https://api.inaturalist.org/v1
GBIF_API_BASE=https://api.gbif.org/v1
CACHE_TTL_SECONDS=3600
