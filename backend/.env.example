# FelidLens Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Identification Service Configuration
# CLASSIFIER_PROVIDER: "onnx" | "dev_mock" | "auto"
CLASSIFIER_PROVIDER=auto
MODEL_PATH=models/felidae_classifier.onnx
CONFIDENCE_THRESHOLD=0.35
UNCERTAINTY_ENTROPY_THRESHOLD=1.85
MAX_IMAGE_SIZE_MB=15

# External Wildlife APIs (Optional keys for higher rate limits)
INATURALIST_API_BASE=https://api.inaturalist.org/v1
GBIF_API_BASE=https://api.gbif.org/v1
CACHE_TTL_SECONDS=3600
